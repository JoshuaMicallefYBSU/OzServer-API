NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://ozserver:change-me@localhost:5432/ozserver
POSTGRES_PASSWORD=change-me
WEBSITE_ORIGIN=https://ozserver.org
DISCONNECT_GRACE_MINUTES=5
RESUME_WINDOW_MINUTES=5
FDR_RETAIN_MINUTES=15
ATIS_RETAIN_MINUTES=60
NETWORK_ATIS_RETAIN_MINUTES=90
# Requests one address may make per ten seconds before it is answered 429.
RATE_LIMIT_PER_10S=300
# Open /api/v1/events streams held at once.
MAX_EVENT_SUBSCRIBERS=500
# Set (16+ characters) to require a token on GET /api/v1/client-logs. Unset leaves it public.
# CLIENT_LOGS_TOKEN=
# Set (16+ characters) to require a token on PUT /api/v1/vatsim/atis/:icao. Unset lets any
# caller publish an ATIS.
# ATIS_TOKEN=
