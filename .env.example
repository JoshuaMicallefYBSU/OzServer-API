NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://ozserver:change-me@localhost:5432/ozserver
POSTGRES_PASSWORD=change-me
WEBSITE_ORIGIN=https://ozserver.org
DISCONNECT_GRACE_MINUTES=5
# Seconds without a request from a controller before another may claim their sector outright.
# Keep at about twice the plugin's 3 second ownership poll - see config.ts.
PRESENCE_TIMEOUT_SECONDS=6
RESUME_WINDOW_MINUTES=5
FDR_RETAIN_MINUTES=15
ATIS_RETAIN_MINUTES=60
NETWORK_ATIS_RETAIN_MINUTES=90
# Requests one address may make per ten seconds before it is answered 429.
RATE_LIMIT_PER_10S=300
# Open /api/v1/events streams held at once.
MAX_EVENT_SUBSCRIBERS=500
# Set (16+ characters) to require a token on GET /api/v1/client-logs. Unset leaves it public.
# CLIENT_LOGS_TOKEN=
# Set (16+ characters) to require a token on PUT /api/v1/vatsim/atis/:icao. Unset lets any
# caller publish an ATIS.
# ATIS_TOKEN=
# The GitHub repository whose releases GET /api/v1/plugin/release offers to the plugin's updater.
# PLUGIN_RELEASE_REPO=JoshuaMicallefYBSU/OzServer-Plugin
# Set to hold a release back: no version newer than this is offered. Unset offers the newest.
# PLUGIN_RELEASE_MAX_VERSION=
# Set to a Discord webhook URL to have plugin and server errors relayed to that channel. Treat it
# as a password: anyone holding the URL can post there.
# DISCORD_WEBHOOK_URL=
# Plugin log categories relayed to Discord, comma-separated.
# DISCORD_LOG_CATEGORIES=Error
# Set to a Discord webhook URL to keep live network stats in that channel, edited every
# LIVE_STATS_INTERVAL_SECONDS. A credential, like DISCORD_WEBHOOK_URL.
# DISCORD_LIVE_WEBHOOK_URL=
# Existing messages in that channel to edit rather than post anew: controllers=<id>,fir_tags=<id>
# DISCORD_LIVE_MESSAGE_IDS=
# LIVE_STATS_INTERVAL_SECONDS=60
